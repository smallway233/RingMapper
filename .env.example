# 与闪韵谱库（Blitz）使用同一套 PICO 账号关联凭证。
# 复制为 .env 后填写。不要提交真实密钥。
# PICO_CLIENT_ID 或 PICO_CLIENT_SECRET 留空时，首页不显示登录，可直接编辑。
PICO_AUTH_DOMAIN=https://openid.picovr.com
PICO_CLIENT_ID=
PICO_CLIENT_SECRET=
# 必须与 PICO 开发者平台「SSO 配置」里登记的回调完全一致。
PICO_REDIRECT_URI=http://127.0.0.1:5173/api/auth/pico/callback
SESSION_SECRET=请改成足够长的随机字符串
# 自动化测试可设为 1，跳过首页登录闸门。
# RINGMAPPER_SKIP_LOGIN=1
